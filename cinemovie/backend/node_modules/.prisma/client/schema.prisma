generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id         Int              @id @default(autoincrement())
  username        String           @unique @db.VarChar(25)
  email           String           @unique @db.VarChar(100)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  profile_picture String?          @db.VarChar(255)
  country         String?          @db.VarChar(45)
  join_date       DateTime         @default(dbgenerated("CURRENT_DATE")) @db.Date
  role            String           @default("user") @db.VarChar(20)
  is_banned       Boolean?         @default(false)
  is_restricted   Boolean?         @default(false)
  ban_reason      String?          @db.VarChar(255)
  followers       Follow[]         @relation("followee")
  following       Follow[]         @relation("follower")
  lists           List[]
  reviews         Review[]
  review_comment  review_comment[]
  review_like     review_like[]
  watchlistItems  WatchlistEntry[]

  @@map("users")
}

model Follow {
  followerId  Int      @map("follower_id")
  followeeId  Int      @map("followee_id")
  follow_date DateTime @default(now()) @db.Timestamp(6)
  followee    User     @relation("followee", fields: [followeeId], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  follower    User     @relation("follower", fields: [followerId], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([followerId, followeeId])
  @@index([followeeId], map: "idx_follow_followee")
  @@map("follow")
}

model Content {
  content_id     Int              @id @default(autoincrement())
  title          String           @db.VarChar(200)
  contentType    String           @map("content_type") @db.VarChar(10)
  releaseYear    Int?             @map("release_year") @db.SmallInt
  duration_min   Int?
  language       String?          @db.VarChar(40)
  country        String?          @db.VarChar(45)
  synopsis       String?
  poster_url     String?          @db.VarChar(255)
  imdb_id        String?          @unique @db.VarChar(15)
  content_award  content_award[]
  genres         ContentGenre[]
  persons        ContentPerson[]
  list_content   list_content[]
  reviews        Review[]
  seasons        Season[]
  watchlistItems WatchlistEntry[]

  @@index([contentType], map: "idx_content_type")
  @@index([releaseYear], map: "idx_content_year")
  @@map("content")
}

model Genre {
  genre_id   Int            @id @default(autoincrement())
  genre_name String         @unique @db.VarChar(50)
  contents   ContentGenre[]

  @@map("genre")
}

model ContentGenre {
  contentId Int     @map("content_id")
  genreId   Int     @map("genre_id")
  content   Content @relation(fields: [contentId], references: [content_id], onDelete: Cascade, onUpdate: NoAction)
  genre     Genre   @relation(fields: [genreId], references: [genre_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([contentId, genreId])
  @@map("content_genre")
}

model Person {
  person_id   Int             @id @default(autoincrement())
  full_name   String          @db.VarChar(100)
  bdate       DateTime?       @db.Date
  nationality String?         @db.VarChar(45)
  biography   String?
  photo_url   String?         @db.VarChar(500)
  contents    ContentPerson[]

  @@map("person")
}

model ContentPerson {
  contentId Int     @map("content_id")
  personId  Int     @map("person_id")
  role      String  @db.VarChar(30)
  content   Content @relation(fields: [contentId], references: [content_id], onDelete: Cascade, onUpdate: NoAction)
  person    Person  @relation(fields: [personId], references: [person_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([contentId, personId, role])
  @@map("content_person")
}

model Season {
  season_id    Int     @id @default(autoincrement())
  contentId    Int     @map("content_id")
  seasonNumber Int     @map("season_number") @db.SmallInt
  episodeCount Int?    @map("episode_count") @db.SmallInt
  releaseYear  Int?    @map("release_year") @db.SmallInt
  content      Content @relation(fields: [contentId], references: [content_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([contentId, seasonNumber])
  @@map("season")
}

model Award {
  award_id      Int             @id @default(autoincrement())
  award_name    String          @db.VarChar(100)
  organization  String?         @db.VarChar(100)
  year          Int?            @db.SmallInt
  content_award content_award[]

  @@map("award")
}

model WatchlistEntry {
  entry_id        Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  contentId       Int       @map("content_id")
  status          String    @db.VarChar(20)
  added_date      DateTime  @default(now()) @db.Timestamp(6)
  finished_date   DateTime? @db.Date
  episodeProgress Int?      @default(0) @map("episode_progress")
  content         Content   @relation(fields: [contentId], references: [content_id], onDelete: Cascade, onUpdate: NoAction)
  user            User      @relation(fields: [userId], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, contentId])
  @@index([contentId], map: "idx_watchlist_content")
  @@index([userId], map: "idx_watchlist_user")
  @@map("watchlist_entry")
}

model Review {
  review_id      Int              @id @default(autoincrement())
  userId         Int              @map("user_id")
  contentId      Int              @map("content_id")
  rating         Int              @db.SmallInt
  comment        String?
  review_date    DateTime         @default(now()) @db.Timestamp(6)
  like_count     Int              @default(0)
  content        Content          @relation(fields: [contentId], references: [content_id], onDelete: Cascade, onUpdate: NoAction)
  user           User             @relation(fields: [userId], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  review_comment review_comment[]
  review_like    review_like[]

  @@unique([userId, contentId])
  @@index([contentId], map: "idx_review_content")
  @@index([userId], map: "idx_review_user")
  @@map("review")
}

model List {
  list_id      Int            @id @default(autoincrement())
  userId       Int            @map("user_id")
  list_name    String         @db.VarChar(100)
  description  String?
  isPublic     Boolean        @default(true) @map("is_public")
  created_date DateTime       @default(now()) @db.Timestamp(6)
  user         User           @relation(fields: [userId], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  list_content list_content[]

  @@map("list")
}

model content_award {
  content_id Int
  award_id   Int
  category   String? @db.VarChar(100)
  award      Award   @relation(fields: [award_id], references: [award_id], onDelete: Cascade, onUpdate: NoAction)
  content    Content @relation(fields: [content_id], references: [content_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([content_id, award_id])
}

model list_content {
  list_id    Int
  content_id Int
  added_date DateTime @default(now()) @db.Timestamp(6)
  content    Content  @relation(fields: [content_id], references: [content_id], onDelete: Cascade, onUpdate: NoAction)
  list       List     @relation(fields: [list_id], references: [list_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([list_id, content_id])
}

model review_comment {
  comment_id Int      @id @default(autoincrement())
  review_id  Int
  user_id    Int
  body       String
  created_at DateTime @default(now()) @db.Timestamp(6)
  review     Review   @relation(fields: [review_id], references: [review_id], onDelete: Cascade, onUpdate: NoAction)
  users      User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([review_id], map: "idx_review_comment_review")
}

model review_like {
  user_id    Int
  review_id  Int
  created_at DateTime @default(now()) @db.Timestamp(6)
  review     Review   @relation(fields: [review_id], references: [review_id], onDelete: Cascade, onUpdate: NoAction)
  users      User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, review_id])
  @@index([review_id], map: "idx_review_like_review")
}
